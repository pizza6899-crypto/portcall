# Absolute path to the Obsidian vault to serve. Required.
PORTCALL_VAULT_PATH=/absolute/path/to/vault

# TCP port to listen on.
PORTCALL_PORT=7100

# Bind interface. Loopback by default — put a tunnel or proxy in front to expose it.
PORTCALL_HOST=127.0.0.1

# Static bearer token required on every mount. Empty means no authentication.
# Note: some MCP clients cannot send request headers; enforce upstream for those.
PORTCALL_TOKEN=

# Also mount the named plugin at /mcp, e.g. `vault`. Empty disables the alias.
PORTCALL_ALIAS_ROOT_MCP=

# SSE comment-frame keepalive interval in milliseconds. 0 disables.
PORTCALL_KEEPALIVE_MS=15000

# Reject 2025-era requests instead of serving them statelessly.
PORTCALL_MODERN_ONLY=false
