# Absolute path to the Obsidian vault to serve. Required.
PORTCALL_VAULT_PATH=/absolute/path/to/vault

# Folders write_image may copy a local file from, colon-separated, `~/` expanded.
# Empty means none: the vault mount otherwise reads nothing outside the vault.
PORTCALL_VAULT_IMPORT_DIRS=

# TCP port to listen on.
PORTCALL_PORT=7100

# Bind interface. Loopback by default — put a tunnel or proxy in front to expose it.
PORTCALL_HOST=127.0.0.1

# Static bearer token required on every mount. Empty means no authentication.
# Note: some MCP clients cannot send request headers; enforce upstream for those.
PORTCALL_TOKEN=

# Also mount the named plugin at /mcp, e.g. `vault`. Empty disables the alias.
PORTCALL_ALIAS_ROOT_MCP=

# Serve every mount under /<prefix>/…, for clients that cannot send a header.
# A bearer secret in a weaker place: it reaches proxy logs. Empty disables it.
PORTCALL_PATH_PREFIX=

# SSE comment-frame keepalive interval in milliseconds. 0 disables.
PORTCALL_KEEPALIVE_MS=15000

# Reject 2025-era requests instead of serving them statelessly.
PORTCALL_MODERN_ONLY=false

# Failed authentications from one client before it is blocked. 0 disables.
PORTCALL_GUARD_FAILURES=5
# How far back those failures are counted, in milliseconds.
PORTCALL_GUARD_WINDOW_MS=300000
# How long a blocked client stays blocked, in milliseconds.
PORTCALL_GUARD_BLOCK_MS=900000
# Requests per client per window. 0 disables the cap.
PORTCALL_GUARD_RATE=600
PORTCALL_GUARD_RATE_WINDOW_MS=60000

# Log every request header, with anything unrecognised reduced to a sketch.
# A diagnostic for bringing up a new client, not something to leave running.
PORTCALL_LOG_HEADERS=false

# Korea Investment credentials. Empty KIS_APP_KEY leaves the KIS mount off.
KIS_APP_KEY=
KIS_APP_SECRET=
# Account number as the app shows it, 12345678-01. Empty serves quotations only.
KIS_ACCOUNT=
